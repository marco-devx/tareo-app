# Puerto local (solo para `npm start`)
PORT=4310

# Carpeta donde se guardan los archivos JSON en modo local (por defecto ./data)
DATA_DIR=./data

# Contraseña compartida opcional. Si se define, la web pedirá esta clave una sola vez por navegador.
APP_PASSWORD=

# --- Solo en Vercel (se agrega solo al conectar un Blob Store al proyecto) ---
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# 'private' (recomendado, el store debe crearse como Private) o 'public'
# BLOB_ACCESS=private
# Carpeta dentro del store donde viven los archivos JSON
# BLOB_PREFIX=tareo-db
